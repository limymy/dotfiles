      "variant": "xhigh"
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "momus": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "librarian": {
