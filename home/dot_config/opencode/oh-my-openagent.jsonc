    },
    "artistry": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max"
    },
    "visual-engineering": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4",
      "variant": "high"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "high"
