{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "disabled_hooks": [
    "ralph-loop"
  ],
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-6",
      "variant": "max",
      "ultrawork": {
        "model": "anthropic/claude-opus-4-6",
        "variant": "max"
      }
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium"
    },
    "prometheus": {
      // "model": "openai/gpt-5.2",
      // "variant": "xhigh"
      "model": "anthropic/claude-opus-4-6",
      "variant": "max"
    },
    "atlas": {
      "model": "anthropic/claude-opus-4-6",
      "variant": "max"
    },
    "metis": {
      "model": "anthropic/claude-opus-4-6",
      "variant": "high"
    },
    "momus": {
      "model": "anthropic/claude-opus-4-6",
      "variant": "max"
    },
    "oracle": {
      "model": "openai/gpt-5.2-pro",
      "variant": "xhigh"
    },
    "librarian": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.3-codex",
      "variant": "low"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.2",
      "variant": "high"
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-5.2"
    },
    "visual-engineering": {
      "model": "anthropic/claude-opus-4-6",
      "variant": "max",
      "temperature": 0.8
    },
    "ultrabrain": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.2",
      "variant": "medium"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh"
    },
    "deep-reasoning": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh"
    }
  },
  "_migrations": [
    "model-version:openai/gpt-5.2-codex->openai/gpt-5.3-codex"
  ]
}
